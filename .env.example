# ---------------------------------------------------------------------------
# Breeze -- the only file you need to create.
#
#   cp .env.example .env      (or just run ./setup.sh, which does it for you)
#
# docker-compose.yml fans these out to each service under the names that
# service expects, so a value like the shared API key is written once here
# instead of twice in two files.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Shared secret between the Next.js frontend and the FastAPI backend. Any
# random string; both sides just have to agree. setup.sh generates one.
BREEZE_API_KEY=change-me

# Signs NextAuth JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Password for the demo account on the landing page.
PLATFORM_PASSWORD=change-me

# --- Ollama ---------------------------------------------------------------

# Ollama runs on the *host*, not in a container, so it keeps your GPU without
# any device passthrough. `host.docker.internal` is mapped to the host gateway
# in docker-compose.yml, which is what makes this work on Linux as well as
# macOS and Windows.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- MongoDB --------------------------------------------------------------

# Defaults to the `mongo` service in docker-compose.yml. Point it at an Atlas
# connection string instead if you would rather not run the container.
MONGO_URI=mongodb://mongo:27017/breeze

# --- URLs -----------------------------------------------------------------

# Where the browser reaches the app. Change the port here *and* in
# docker-compose.yml if 3000 is taken.
NEXTAUTH_URL=http://localhost:3000

# --- Optional -------------------------------------------------------------

# Web search. Without it, search silently falls back to a keyless DuckDuckGo
# scrape -- lower quality, but the app works.
TAVILY_API_KEY=

# LLM tracing. Leave blank to disable; the backend logs a warning and runs on.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Generative-UI model. Blank means "use local Ollama with MODELS['genui']",
# so a fresh clone needs no extra credentials. Set all three to answer widget
# turns with a stronger hosted OpenAI-compatible model.
UI_MODEL_BASE_URL=
UI_MODEL_API_KEY=
UI_MODEL_NAME=

# Host port MongoDB is published on (loopback only), for Compass / mongosh.
# Change it if you already have a MongoDB listening on 27017.
MONGO_HOST_PORT=27017
